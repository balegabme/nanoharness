{
  "name": "nanoharness",
  "version": "0.6.0",
  "description": "Minimal, token-efficient, self-documenting coding harness.",
  "main": "out/main/index.js",
  "bin": {
    "nh": "out/cli/index.js"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts eslint.config.js",
    "doc-check": "pnpm build && node out/cli/index.js doc-check",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "pnpm build && electron ."
  },
  "license": "Apache-2.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.12.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1"
  }
}
